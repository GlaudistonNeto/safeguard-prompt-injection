{
  "name": "safeguard-prompt-injection",
  "version": "1.0.0",
  "description": "Educational demonstration of prompt injection and LLM guardrails",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "chat": "node --env-file .env --experimental-strip-types src/index.ts",
    "typecheck": "tsc --noEmit",
    "langgraph:serve": "pnpm dlx @langchain/langgraph-cli dev"
  },
  "keywords": [
    "langchain",
    "langgraph",
    "security",
    "prompt-injection",
    "guardrails",
    "openrouter"
  ],
  "dependencies": {
    "@langchain/core": "^1.3.7",
    "@langchain/langgraph": "^1.7.3",
    "@langchain/mcp-adapters": "^2.0.0",
    "@langchain/openai": "^1.8.3",
    "langchain": "^1.6.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}